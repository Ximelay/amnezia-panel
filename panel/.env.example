# VPN Name Service
NEXT_PUBLIC_VPN_NAME="AmneziaVPN"
# true or false
NEXT_PUBLIC_USES_TELEGRAM_BOT="true"

# PostgreSQL database
DB_USER="username"
DB_PASSWORD="password"
DB_NAME="panel"
DATABASE_URL="postgresql://username:password@db:5432/panel"

# Telegram Bot Token (optional)
TELEGRAM_BOT_TOKEN=""

# How long a VPN key may stay in the client's Telegram chat before the cleanup cron
# deletes the message, in minutes. 0 turns automatic cleanup off; unset means 720 (12 h).
# Telegram refuses to delete a bot message older than 48 hours, so anything above 2820 is
# clamped down to it — otherwise the key would stay in the chat forever.
TELEGRAM_KEY_TTL_MINUTES="720"

# --- Client-facing bot (scripts/telegram-bot.sh, once a minute) --------------------------
# Lets clients pull their own keys, QR codes and subscription dates from the bot instead
# of asking an admin. Requires TELEGRAM_BOT_TOKEN and the per-minute cron job.

# Whether a client may replace a broken key themselves. Set to "false" to keep reissues
# in the panel only — the button then tells the client to contact an admin.
TELEGRAM_BOT_ALLOW_REISSUE="true"

# How often one client may pull their keys and QR codes, per rolling 24 hours. These are
# not a security boundary — whoever holds the key already has access — they exist so an
# unusual number of requests shows up in the logs instead of passing unnoticed.
BOT_KEYS_PER_DAY="5"
BOT_QR_PER_DAY="5"

# Replacing a config costs a round trip to the VPN server and breaks every device using
# the old key, so it is metered twice: per config, and across all of a client's configs.
BOT_REISSUE_PER_CONFIG_PER_DAY="1"
BOT_REISSUE_PER_MONTH="3"

# Key for encrypt data
ENCRYPTION_KEY=""

# Cron secret key
CRON_SECRET="any secret key"
# Root secret key
ROOT_SECRET="any secret key"

# Auth secret key
AUTH_SECRET=""

# development or test or production
NODE_ENV="production"