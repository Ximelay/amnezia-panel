generator client {
    provider = "prisma-client"
    output   = "./generated"
}

datasource db {
    provider = "postgresql"
    // url      = env("DATABASE_URL")
}

model Servers {
    id        Int       @id @default(autoincrement())
    createdAt DateTime  @default(now())
    name      String
    ip        String
    port      Int
    apiKey    Json
    Configs   Configs[]
}

model Clients {
    id         Int       @id @default(autoincrement())
    createdAt  DateTime  @default(now())
    name       String
    language   Languages
    telegramId String?
    status     Boolean   @default(true)
    Configs    Configs[]
}

model Configs {
    id         String    @id
    createdAt  DateTime  @default(now())
    clientName String
    vpnKey     Json
    expiresAt  String?
    status     Boolean   @default(true)
    protocol   Protocols
    clientId   Int?
    serverId   Int
    Clients    Clients?  @relation(fields: [clientId], references: [id])
    Servers    Servers   @relation(fields: [serverId], references: [id])
}

model Logs {
    id        Int        @id @default(autoincrement())
    createdAt DateTime   @default(now())
    logType   LogTypes
    levelType LevelTypes
    message   String
}

enum Protocols {
    AMNEZIAWG
    XRAY
}

enum LevelTypes {
    INFO
    WARNING
    ERROR
}

enum LogTypes {
    TELEGRAM
    SERVER
    CLIENT
}

enum Languages {
    RUSSIAN
    ENGLISH
}
