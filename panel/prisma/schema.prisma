generator client {
    provider = "prisma-client"
    output   = "./generated"
}

datasource db {
    provider = "postgresql"
    // url      = env("DATABASE_URL")
}

model Servers {
    id        Int       @id @default(autoincrement())
    createdAt DateTime  @default(now())
    name      String
    ip        String
    port      Int
    apiKey    Json
    Configs   Configs[]
}

model Admins {
    id           String   @id @default(cuid())
    createdAt    DateTime @default(now())
    login        String   @unique
    password     String
    role         Roles
    isFirstLogin Boolean  @default(true)
    Logs         Logs[]
}

model Clients {
    id         Int       @id @default(autoincrement())
    createdAt  DateTime  @default(now())
    name       String
    language   Languages
    telegramId String?
    status     Boolean   @default(true)
    Configs    Configs[]

    // Single-use payload for a t.me deep link, cleared once the chat id is bound.
    telegramLinkToken     String?   @unique
    telegramLinkExpiresAt DateTime?
}

model Configs {
    id         String    @id
    createdAt  DateTime  @default(now())
    clientName String
    vpnKey     Json
    expiresAt  String?
    status     Boolean   @default(true)
    protocol   Protocols
    // AmneziaWG 2.0 and 3.x share one API protocol, so the concrete version is only
    // known from the config the server hands back ("2", "3.1"). Null for rows created
    // before this was recorded, and for protocols that carry no version.
    protocolVersion String?
    clientId   Int?
    serverId   Int
    Clients    Clients?  @relation(fields: [clientId], references: [id])
    Servers    Servers   @relation(fields: [serverId], references: [id])
}

/// Bot messages that carry a VPN key, tracked so they can be removed from the client's
/// chat later. Telegram refuses to delete anything sent more than 48 hours ago, so a row
/// is only actionable inside that window.
model TelegramKeyMessages {
    id        Int       @id @default(autoincrement())
    createdAt DateTime  @default(now())
    chatId    String
    messageId Int
    // One message can carry up to three keys, so this is a list rather than a relation.
    // Deliberately not a foreign key: the message has to be deletable from the chat
    // exactly when the config or client row is already gone.
    configIds String[]
    clientId  Int?
    deletedAt DateTime?

    @@unique([chatId, messageId])
    @@index([deletedAt, createdAt])
}

model Logs {
    id        Int        @id @default(autoincrement())
    createdAt DateTime   @default(now())
    logType   LogTypes
    levelType LevelTypes
    message   String
    adminId   String?
    Admins    Admins?    @relation(fields: [adminId], references: [id])
}

model PaymentSettings {
    id                  Int      @id @default(autoincrement())
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt
    defaultPrice        Float
    additionalPrice     Float
    defaultConfigsCount Int
    paymentLink         String
    adminTelegramIds    Json? // String[]
}

enum Roles {
    ROOT
    ADMIN
}

enum Protocols {
    AMNEZIAWG
    AMNEZIAWG2
    XRAY
}

enum LevelTypes {
    INFO
    WARNING
    ERROR
}

enum LogTypes {
    ADMIN
    TELEGRAM
    SERVER
    CLIENT
}

enum Languages {
    RUSSIAN
    ENGLISH
}
