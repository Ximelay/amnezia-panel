generator client {
    provider = "prisma-client"
    output   = "./generated"
}

datasource db {
    provider = "postgresql"
    // url      = env("DATABASE_URL")
}

model Servers {
    id        Int       @id @default(autoincrement())
    createdAt DateTime  @default(now())
    name      String
    ip        String
    port      Int
    apiKey    Json
    Configs   Configs[]
}

model Admins {
    id           String   @id @default(cuid())
    createdAt    DateTime @default(now())
    login        String   @unique
    password     String
    role         Roles
    isFirstLogin Boolean  @default(true)
    Logs         Logs[]
}

model Clients {
    id          Int                 @id @default(autoincrement())
    createdAt   DateTime            @default(now())
    name        String
    language    Languages
    telegramId  String?
    status      Boolean             @default(true)
    Configs     Configs[]
    BotRequests ClientBotRequests[]

    // Single-use payload for a t.me deep link, cleared once the chat id is bound.
    telegramLinkToken     String?   @unique
    telegramLinkExpiresAt DateTime?

    // Deliberately not unique, even though two clients sharing a chat is always a
    // mistake: the constraint would have to be added to a table that may already hold
    // duplicates, and `db push` runs unattended on every container start. The bot
    // refuses to serve an ambiguous chat instead, which fails safe without a migration
    // that can strand the deployment.
    @@index([telegramId])
}

model Configs {
    id         String    @id
    createdAt  DateTime  @default(now())
    clientName String
    vpnKey     Json
    expiresAt  String?
    status     Boolean   @default(true)
    protocol   Protocols
    // AmneziaWG 2.0 and 3.x share one API protocol, so the concrete version is only
    // known from the config the server hands back ("2", "3.1"). Null for rows created
    // before this was recorded, and for protocols that carry no version.
    protocolVersion String?
    clientId   Int?
    serverId   Int
    Clients    Clients?  @relation(fields: [clientId], references: [id])
    Servers    Servers   @relation(fields: [serverId], references: [id])
}

/// Bot messages that carry a VPN key, tracked so they can be removed from the client's
/// chat later. Telegram refuses to delete anything sent more than 48 hours ago, so a row
/// is only actionable inside that window.
model TelegramKeyMessages {
    id        Int       @id @default(autoincrement())
    createdAt DateTime  @default(now())
    chatId    String
    messageId Int
    // One message can carry up to three keys, so this is a list rather than a relation.
    // Deliberately not a foreign key: the message has to be deletable from the chat
    // exactly when the config or client row is already gone.
    configIds String[]
    clientId  Int?
    deletedAt DateTime?

    @@unique([chatId, messageId])
    @@index([deletedAt, createdAt])
}

/// Cursor of the bot poller, in a single row.
///
/// Telegram keeps handing out an update until a later poll confirms it by asking for a
/// higher offset, so without this the bot would answer the same message on every run.
/// Confirmation happens only after the update has been handled, which makes a crash
/// mid-handling replay the update rather than swallow it.
model TelegramBotState {
    id           Int      @id @default(1)
    lastUpdateId BigInt   @default(0)
    updatedAt    DateTime @updatedAt

    /// Held for the length of one polling run so two overlapping runs cannot both
    /// consume the same updates. A timestamp rather than a Postgres advisory lock
    /// because Prisma hands out a different pooled connection per query, and a
    /// session-scoped lock would then be released by the wrong one.
    lockedUntil DateTime?

    /// Fingerprint of the command list last published to Telegram, so the bot re-registers
    /// it only when the wording actually changed rather than on every polling run.
    commandsHash String?
}

/// Ledger of everything a client asked the bot to do.
///
/// Serves two purposes at once: it is the rate limiter (a window is a count over
/// `createdAt`) and the audit trail for who pulled their key when — which is also the
/// only record that survives a reissue deleting the config it was aimed at.
model ClientBotRequests {
    id        Int        @id @default(autoincrement())
    createdAt DateTime   @default(now())
    clientId  Int
    action    BotActions
    /// Not a foreign key on purpose: a reissue deletes the config row this names, and
    /// the fact that the client asked for it has to outlive the config.
    configId  String?
    Clients   Clients    @relation(fields: [clientId], references: [id], onDelete: Cascade)

    @@index([clientId, action, createdAt])
}

model Logs {
    id        Int        @id @default(autoincrement())
    createdAt DateTime   @default(now())
    logType   LogTypes
    levelType LevelTypes
    message   String
    adminId   String?
    Admins    Admins?    @relation(fields: [adminId], references: [id])
}

model PaymentSettings {
    id                  Int      @id @default(autoincrement())
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt
    defaultPrice        Float
    additionalPrice     Float
    defaultConfigsCount Int
    paymentLink         String
    adminTelegramIds    Json? // String[]
}

enum Roles {
    ROOT
    ADMIN
}

enum Protocols {
    AMNEZIAWG
    AMNEZIAWG2
    XRAY
}

enum LevelTypes {
    INFO
    WARNING
    ERROR
}

enum LogTypes {
    ADMIN
    TELEGRAM
    SERVER
    CLIENT
}

enum Languages {
    RUSSIAN
    ENGLISH
}

enum BotActions {
    KEYS
    QR
    REISSUE
    STATUS
    APPS
}
